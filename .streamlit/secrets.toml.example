# Copy to .streamlit/secrets.toml for local testing,
# or paste the same content into Streamlit Cloud's "Secrets" panel
# (https://share.streamlit.io -> your app -> Settings -> Secrets).
#
# .streamlit/secrets.toml is gitignored — never commit your real key.

ANTHROPIC_API_KEY = "sk-ant-..."

# Username + password to gate the app. Pick values only you know.
APP_USERNAME = "farman"
APP_PASSWORD = "change-me-to-a-real-password"

# (Optional) Notion integration to publish applied jobs.
#
# Setup:
#   1. https://www.notion.so/profile/integrations -> New internal integration -> copy token
#   2. Create a Notion database. Recommended columns (all optional; the app
#      auto-detects and only fills what exists):
#        - Title       (title, required by Notion)
#        - Company     (Text)
#        - Location    (Text)
#        - Role        (Text)
#        - Status      (Select with at least the option "Applied")
#        - Date Applied (Date)
#        - Coverage    (Number)
#        - JD URL      (URL)
#        - Resume PDF  (Files & media)
#   3. Open the DB in notion.so -> ... menu -> Connections -> Add connections
#      -> select your integration.
#   4. The database ID is the UUID right after notion.so/, BEFORE the '?v=' view
#      parameter: notion.so/<workspace>/<DB_ID>?v=...
# Leave both empty to keep applications local-session only.
NOTION_TOKEN = ""
NOTION_DATABASE_ID = ""
